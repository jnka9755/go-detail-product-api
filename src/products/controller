package products

import (
	"encoding/json"
	"fmt"
	"net/http"
)

type (
	Controller func(w http.ResponseWriter, r *http.Request)

	// Endpoints is a struct that contains all the controllers
	Endpoints struct {
		GetProductsDetail Controller
	}
)

func MakeEndpoints() Endpoints {
	return Endpoints{
		GetProductsDetail: makeGetProductsDetailEndpoint(),
	}
}

func makeGetProductsDetailEndpoint() Controller {
	return func(w http.ResponseWriter, r *http.Request) {
		fmt.Println("getProductsDetail Endpoint")
		json.NewEncoder(w).Encode(map[string]bool{"ok": true})
	}
}
